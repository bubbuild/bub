---
export const prerender = false;

import { getCollection } from 'astro:content';
import Features from '@/components/Features.astro';
import GetStarted from '@/components/GetStarted.astro';
import Hero from '@/components/Hero.astro';
import HookIntro from '@/components/HookIntro.astro';
import TapeModel from '@/components/TapeModel.astro';
import Testimonials from '@/components/Testimonials.astro';
import { getLandingPageData } from '@/data/landing-page';
import { getLocaleFromParam, useTranslations } from '@/i18n/utils';
import { getRepoStats, gitHubAvatarUrl } from '@/lib/github';
import LandingLayout from '@/layouts/LandingLayout.astro';

// In SSR mode, read locale from the catch-all param.
// `/`       → locale = undefined → defaultLang ('en')
// `/zh-cn/` → locale = 'zh-cn'
const { locale: localeParam } = Astro.params;
const locale = getLocaleFromParam(localeParam);

// Guard against catch-all hits from unknown paths (e.g. /foo/).
if (!locale) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageData = getLandingPageData(locale);
const ogImage = locale === 'en' ? '/og/index.png' : `/og/${locale}/index.png`;
const { contributors } = getRepoStats();

const userwallEntries = await getCollection('userwall');
const testimonialItems = userwallEntries.map((entry) => ({
  ...entry.data,
  avatar: gitHubAvatarUrl(entry.data.github),
}));
---

<LandingLayout title={t('site.title')} description={t('site.description')} ogImage={ogImage}>
  <Hero {...pageData.hero} contributors={contributors} />
  <GetStarted {...pageData.getStarted} />
  <Features {...pageData.features} />
  <HookIntro {...pageData.hookIntro} />
  <TapeModel {...pageData.tapeModel} />
  <Testimonials {...pageData.testimonials} testimonials={testimonialItems} />
</LandingLayout>
