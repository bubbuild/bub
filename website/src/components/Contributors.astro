---
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import { CONTRIBUTORS_URL } from '@/lib/github';
import type { GitHubContributor } from '@/lib/github';

interface Props {
  contributors: GitHubContributor[];
  label: string;
}

const { contributors, label } = Astro.props;
---

<div class="flex flex-col gap-2.5">
  <div class="flex -space-x-3">
    {contributors.map((c) => (
      <a
        href={c.html_url}
        target="_blank"
        rel="noreferrer"
        title={c.login}
        class="group relative z-0 block size-8 rounded-full hover:z-10 md:size-9"
      >
        <span
          class="pointer-events-none absolute inset-0 block overflow-hidden rounded-full border-2 border-background text-muted-foreground transition-transform duration-200 ease-out group-hover:-translate-y-2 group-hover:scale-110"
        >
          <Avatar src={c.avatar_url} alt={c.login} />
        </span>
      </a>
    ))}
    <a
      href={CONTRIBUTORS_URL}
      target="_blank"
      rel="noreferrer"
      class="flex size-8 items-center justify-center rounded-full border-2 border-background bg-secondary text-muted-foreground transition-transform duration-200 ease-out hover:-translate-y-1 hover:scale-105 hover:text-foreground md:size-9"
      title="View all contributors on GitHub"
      aria-label="View all contributors on GitHub"
    >
      <Icon name="ellipsis" size={14} aria-hidden="true" />
    </a>
  </div>
  <span class="text-xs leading-relaxed text-muted-foreground">{label}</span>
</div>
