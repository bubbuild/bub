---
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import type { TestimonialItem } from '@/data/landing-page';

/** Accent variant — maps to the `--site-testimonial-N` color tokens. */
type TestimonialVariant = 1 | 2 | 3 | 4 | 5;

/** Kept as literal strings so Tailwind can statically detect them. */
const variantBorder: Record<TestimonialVariant, string> = {
  1: 'border-l-[var(--site-testimonial-1)]',
  2: 'border-l-[var(--site-testimonial-2)]',
  3: 'border-l-[var(--site-testimonial-3)]',
  4: 'border-l-[var(--site-testimonial-4)]',
  5: 'border-l-[var(--site-testimonial-5)]',
};

interface Props {
  testimonial: TestimonialItem;
  variant?: TestimonialVariant;
}

const { testimonial, variant = 1 } = Astro.props;
---

<div class:list={['border border-border border-l-[3px] bg-card p-4', variantBorder[variant]]}>
  <p class="text-[0.84rem] leading-relaxed text-foreground/85">{testimonial.text}</p>
  <div class="mt-3 flex items-center gap-2.5">
    <div class="relative h-7 w-7 shrink-0 text-muted-foreground/60">
      <Avatar src={testimonial.avatar} alt={testimonial.name} />
    </div>
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs font-bold text-foreground">{testimonial.name}</p>
      <p class="truncate text-[0.65rem] text-muted-foreground">{testimonial.handle}</p>
    </div>
    {testimonial.platform && (
      <Icon
        name={testimonial.platform === 'x' ? 'x-twitter' : testimonial.platform}
        size={12}
        class="shrink-0 text-muted-foreground/50"
        aria-hidden="true"
      />
    )}
  </div>
</div>
