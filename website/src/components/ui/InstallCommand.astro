---
import Icon from '@/components/ui/Icon.astro';
import type { InstallCommandData } from '@/data/landing-page';
import { Code } from 'astro:components';

interface Props {
  install: InstallCommandData;
}

const { install } = Astro.props;
const { platforms, copyLabel, copiedLabel } = install;

// Both platform commands are rendered up front and toggled client-side, so
// switching never re-highlights anything — it only flips `hidden`. Seeding the
// copy target from the first platform keeps it defined before hydration.
const initialCommand = platforms[0]?.command ?? '';
---

<div
  class="install-command min-w-0 border border-border bg-card text-left shadow-[var(--site-shadow)]"
  data-install-command
  data-command={initialCommand}
  data-copied-label={copiedLabel}
>
  <div class="flex border-b border-border bg-secondary">
    {platforms.map((platform, index) => (
      <button
        type="button"
        class:list={[
          'min-h-11 flex-1 cursor-pointer px-3 font-mono text-xs font-medium',
          'text-muted-foreground transition-colors hover:bg-card/60 hover:text-foreground',
          // Active tab: raised to --card and painted 1px taller so it covers the
          // bar's bottom border and merges into the code surface below it.
          'aria-pressed:relative aria-pressed:z-[1] aria-pressed:bg-card aria-pressed:text-foreground',
          'aria-pressed:shadow-[0_1px_0_var(--card)]',
          'focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring',
          index === 0 && 'border-r border-border',
        ]}
        aria-pressed={index === 0 ? 'true' : 'false'}
        data-platform={platform.id}
        data-command={platform.command}
      >
        {platform.label}
      </button>
    ))}
  </div>
  <div class="flex min-w-0 items-stretch">
    <span class="shrink-0 pl-4 pt-3 font-mono text-sm leading-5 text-muted-foreground" aria-hidden="true">$</span>
    <div class="install-code min-w-0 flex-1 py-3 pl-2 pr-1 font-mono text-sm leading-5">
      {platforms.map((platform, index) => (
        <span data-command-view={platform.id} hidden={index !== 0}>
          <Code
            inline
            wrap
            code={platform.command}
            lang="shellscript"
            themes={{ light: 'night-owl-light', dark: 'night-owl' }}
            defaultColor="light"
          />
        </span>
      ))}
    </div>
    <button
      type="button"
      class:list={[
        'mr-2 flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center self-center',
        'text-muted-foreground transition hover:bg-secondary hover:text-foreground hover:shadow-[var(--site-shadow)]',
        'focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring',
      ]}
      aria-label={copyLabel}
      title={copyLabel}
      data-copy-command
    >
      <span data-copy-icon>
        <Icon name="copy" size={16} aria-hidden="true" />
      </span>
      <span class="hidden text-primary" data-copied-icon>
        <Icon name="check" size={16} aria-hidden="true" />
      </span>
    </button>
  </div>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

<style>
  /* Everything that styles *this* component's own elements is a utility in the
     class list above. What is left cannot be: shiki writes its colours and
     background as inline styles on markup we don't own, so these overrides have
     to target shiki's output and use !important to beat an inline style.

     (The rule also drops shiki's own `padding` / font declarations: the
     container already sets `font-mono text-sm leading-5`, which the inline
     <code> inherits, and <code> has no default padding.) */

  /* The container already draws the code surface (bg-card), so the highlighter
     contributes token colours and word wrapping only. */
  .install-code :global(code.astro-code) {
    background: transparent !important;
  }

  /* Dual-theme output keeps the dark colours in --shiki-dark custom properties;
     swap them in when the site is in dark mode (mirrors Hero.astro). */
  :global(.dark) .install-code :global(code.astro-code span[style*='--shiki-dark']),
  :global([data-theme='dark']) .install-code :global(code.astro-code span[style*='--shiki-dark']) {
    color: var(--shiki-dark) !important;
  }
</style>

<script>
  async function copyText(value: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await Promise.race([
          navigator.clipboard.writeText(value),
          new Promise<never>((_, reject) => {
            window.setTimeout(() => reject(new Error('Clipboard API timed out')), 500);
          }),
        ]);
        return;
      } catch {
        // Fall back when the Clipboard API exists but permission is denied.
      }
    }

    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) {
      throw new Error('Unable to copy the install command');
    }
  }

  for (const container of document.querySelectorAll<HTMLElement>('[data-install-command]')) {
    if (container.dataset.copyReady === 'true') continue;
    container.dataset.copyReady = 'true';

    const button = container.querySelector<HTMLButtonElement>('[data-copy-command]');
    const commandViews = Array.from(
      container.querySelectorAll<HTMLElement>('[data-command-view]'),
    );
    const platformOptions = Array.from(
      container.querySelectorAll<HTMLButtonElement>('[data-platform]'),
    );
    const copyIcon = container.querySelector<HTMLElement>('[data-copy-icon]');
    const copiedIcon = container.querySelector<HTMLElement>('[data-copied-icon]');
    const status = container.querySelector<HTMLElement>('[data-copy-status]');

    const selectPlatform = (selectedOption: HTMLButtonElement) => {
      for (const option of platformOptions) {
        option.setAttribute('aria-pressed', String(option === selectedOption));
      }

      container.dataset.command = selectedOption.dataset.command ?? '';

      const activePlatform = selectedOption.dataset.platform;
      for (const view of commandViews) {
        view.hidden = view.dataset.commandView !== activePlatform;
      }
    };

    for (const option of platformOptions) {
      option.addEventListener('click', () => selectPlatform(option));
    }

    const navigatorWithUserAgentData = navigator as Navigator & {
      userAgentData?: { platform?: string };
    };
    const platform =
      navigatorWithUserAgentData.userAgentData?.platform ?? navigator.platform ?? navigator.userAgent;
    const initialPlatform = /win/i.test(platform) ? 'windows' : 'posix';
    const initialOption = platformOptions.find((option) => option.dataset.platform === initialPlatform);
    if (initialOption) selectPlatform(initialOption);

    button?.addEventListener('click', async () => {
      try {
        await copyText(container.dataset.command ?? '');
      } catch {
        return;
      }

      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (status) status.textContent = container.dataset.copiedLabel ?? '';

      window.setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>
