---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { HookIntroData } from '@/data/landing-page';

type Props = HookIntroData;

const { eyebrow, heading, description, hookStages } = Astro.props;

const SPACING = 72;
const FIRST_Y = 44;
const RX = 296; // right-side node center x
const LX = 104; // left-side node center x
const BEND = 0.5; // 0.5 puts both control points on the midpoint, for a smooth S with vertical tangents
const VB_W = 400;
const VB_H = FIRST_Y + (hookStages.length - 1) * SPACING + FIRST_Y;

const nodeCoords = hookStages.map((_, i) => ({
  x: i % 2 === 0 ? RX : LX,
  y: FIRST_Y + i * SPACING,
}));

/* Serpentine path, with hidden leader / trailer so the loop seam is offscreen */
const first = nodeCoords[0] ?? { x: RX, y: FIRST_Y };
const last = nodeCoords[nodeCoords.length - 1] ?? first;
const segs: string[] = [
  `M ${first.x} ${-44}`,
  `C ${first.x} ${first.y - 20}, ${first.x} ${first.y - 8}, ${first.x} ${first.y}`,
];
for (let i = 1; i < nodeCoords.length; i++) {
  const p = nodeCoords[i - 1],
    c = nodeCoords[i];
  const dy = (c.y - p.y) * BEND;
  segs.push(`C ${p.x} ${p.y + dy}, ${c.x} ${c.y - dy}, ${c.x} ${c.y}`);
}
segs.push(`C ${last.x} ${last.y + 8}, ${last.x} ${last.y + 20}, ${last.x} ${VB_H + 44}`);
const pathD = segs.join(' ');

const CX = VB_W / 2;
const straightPathD = `M ${CX} ${-44} L ${CX} ${VB_H + 44}`;
---

<section class="relative overflow-hidden py-20 md:py-28" data-reveal aria-label="Hook architecture">
  <div class="relative mx-auto max-w-6xl px-5 md:px-8">
    <div class="flex flex-col gap-12 md:flex-row md:items-start md:gap-16 lg:gap-24">
      <div class="md:w-[42%] md:shrink-0">
        <SectionHeading eyebrow={eyebrow} heading={heading} body={description} class="mb-0 max-w-none" />
      </div>

      <div class="hook-flow relative flex-1" data-hook-flow>
        <div class="hook-flow-inner relative mx-auto" style={`aspect-ratio: ${VB_W} / ${VB_H}; max-width: 460px;`}>
          <div class="hook-grid" aria-hidden="true"></div>

          <svg class="absolute inset-0 h-full w-full" viewBox={`0 0 ${VB_W} ${VB_H}`} fill="none" aria-hidden="true">
            <defs>
              <!-- Tracks need end-fades; keep the animating subtree out of a CSS mask -->
              <linearGradient
                id="hook-track-fade"
                gradientUnits="userSpaceOnUse"
                x1="0"
                y1="0"
                x2="0"
                y2={VB_H}
              >
                <stop offset="0%" style="stop-color: var(--border); stop-opacity: 0" />
                <stop offset="7%" style="stop-color: var(--border); stop-opacity: 0.45" />
                <stop offset="93%" style="stop-color: var(--border); stop-opacity: 0.45" />
                <stop offset="100%" style="stop-color: var(--border); stop-opacity: 0" />
              </linearGradient>
            </defs>

            <g class="hook-paths-desktop">
              <path d={pathD} stroke="url(#hook-track-fade)" stroke-width="1.5" stroke-dasharray="6 4" />
              <path
                d={pathD}
                stroke="var(--primary)"
                stroke-width="2.5"
                stroke-linecap="round"
                pathLength="1"
                class="hook-trail"
                data-hook-trail
              />
            </g>

            <g class="hook-paths-mobile">
              <path d={straightPathD} stroke="url(#hook-track-fade)" stroke-width="1.5" stroke-dasharray="6 4" />
              <path
                d={straightPathD}
                stroke="var(--primary)"
                stroke-width="2.5"
                stroke-linecap="round"
                pathLength="1"
                class="hook-trail"
                data-hook-trail-mobile
              />
            </g>

            <!-- Dots sit at the origin; JS moves them with CSS transform -->
            <circle
              r="5.5"
              cx="0"
              cy="0"
              fill="var(--primary)"
              style="opacity: 0; visibility: hidden; will-change: transform"
              data-hook-dot></circle>
            <circle
              r="3"
              cx="0"
              cy="0"
              fill="var(--primary)"
              style="opacity: 0; visibility: hidden; will-change: transform"
              data-hook-dot-trail></circle>
          </svg>

          {hookStages.map((stage, i) => {
            const yPct = (((FIRST_Y + i * SPACING) / VB_H) * 100).toFixed(2);
            const xPct = ((nodeCoords[i].x / VB_W) * 100).toFixed(2);
            return (
              <div
                class="hook-node absolute z-10"
                data-hook-node={i}
                style={`top:${yPct}%;left:${xPct}%;transform:translate(-50%,-50%);`}
              >
                <div class="hook-card">
                  <span class="hook-card-name">{stage.name}()</span>
                  <span class="hook-card-note">{stage.note}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hook-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: calc(var(--radius) * 1.2);
    background-image: radial-gradient(circle, var(--site-grid-dot) 1px, transparent 1px);
    background-size: 18px 18px;
    opacity: 0.18;
    /* Static layer only — masking a repainting subtree costs a re-composite per frame */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 7%, black 93%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 7%, black 93%, transparent 100%);
  }

  /* Layout-only: cards are wider than the box, so paint containment would clip them */
  .hook-flow-inner {
    contain: layout;
  }

  /* Hidden until JS activates the trail */
  .hook-trail {
    opacity: 0;
    stroke-dasharray: 0.14 0.86;
    stroke-dashoffset: 0.14;
  }

  /* :global — these selectors target SVG children */
  :global(.hook-paths-mobile) {
    display: none;
  }
  @media (max-width: 639px) {
    :global(.hook-paths-desktop) {
      display: none;
    }
    :global(.hook-paths-mobile) {
      display: block;
    }
    .hook-node {
      left: 50% !important;
    }
  }

  .hook-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 7px 14px;
    background: var(--card);
    white-space: nowrap;
    box-shadow: var(--site-shadow-card);
    text-align: center;
  }

  .hook-card-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--foreground);
    transition: color 0.35s ease;
  }

  .hook-card-note {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1.3;
    color: var(--muted-foreground);
    opacity: 0.6;
    transition:
      opacity 0.35s ease,
      color 0.35s ease;
  }

  /* Ping stays on the card's own border — opacity only, no scale, no outer glow */
  .hook-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--site-hook-ping-ring);
    box-shadow: inset 0 0 8px var(--site-hook-ping-glow);
    opacity: 0;
    pointer-events: none;
  }

  .hook-node.active .hook-card::after {
    animation: ring-ping 2s ease-out forwards;
  }
  .hook-node.active .hook-card-name {
    color: var(--primary);
  }
  .hook-node.active .hook-card-note {
    opacity: 1;
  }

  @keyframes ring-ping {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    60% {
      opacity: 0.45;
    }
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  import { inView } from 'motion';

  type HookFlowWindow = Window & {
    __bubHookFlowCleanup?: () => void;
    __bubHookFlowPageLoadBound?: boolean;
  };

  /* Must mirror the frontmatter layout constants */
  const RX = 296;
  const LX = 104;
  const FIRST_Y = 44;
  const SPACING = 72;
  const CX_MOBILE = 200;

  const CYCLE_DUR = 7; // seconds per loop
  const REPEAT_DELAY_MS = 400; // pause between loops
  const TRAIL_LEAD = 0.018; // trailing dot lag, as a fraction of path length
  const FADE_ZONE = 0.06; // end fade, as a fraction of path length
  const NEAR_DIST_SQ = 36 * 36; // node hit radius, squared
  const PATH_SAMPLE_COUNT = 560;
  const TRAIL_DASH = 0.14; // must match the .hook-trail dasharray start

  type PathSample = {
    x: number;
    y: number;
    opacity: number;
    nearest: number;
  };

  /** 1 in the middle of the path, ramping to 0 at both ends. */
  function fade(v: number): number {
    if (v < FADE_ZONE) return v / FADE_ZONE;
    if (v > 1 - FADE_ZONE) return (1 - v) / FADE_ZONE;
    return 1;
  }

  type Pt = { x: number; y: number };

  /* Samples the path with local Bezier math: getPointAtLength x561 blocks ~220ms */
  function samplePath(d: string, nodes: Pt[]): PathSample[] {
    const tokens = d.match(/[MLC]|-?\d*\.?\d+/g) ?? [];
    const segs: { p0: Pt; c1: Pt; c2: Pt; p1: Pt }[] = [];
    let cur: Pt = { x: 0, y: 0 };
    let cmd = '';
    let buf: number[] = [];

    const push = () => {
      if (cmd === 'M') {
        cur = { x: buf[0], y: buf[1] };
      } else if (cmd === 'L') {
        const p1 = { x: buf[0], y: buf[1] };
        segs.push({ p0: cur, c1: cur, c2: p1, p1 });
        cur = p1;
      } else if (cmd === 'C') {
        const p1 = { x: buf[4], y: buf[5] };
        segs.push({ p0: cur, c1: { x: buf[0], y: buf[1] }, c2: { x: buf[2], y: buf[3] }, p1 });
        cur = p1;
      }
      buf = [];
    };

    for (const t of tokens) {
      if (t === 'M' || t === 'L' || t === 'C') {
        push();
        cmd = t;
      } else {
        buf.push(Number(t));
      }
    }
    push();

    const SUB = 32;
    const pts: Pt[] = [];
    for (const s of segs) {
      for (let i = 0; i <= SUB; i++) {
        const t = i / SUB;
        const mt = 1 - t;
        const a = mt * mt * mt;
        const b = 3 * mt * mt * t;
        const c = 3 * mt * t * t;
        const e = t * t * t;
        pts.push({
          x: a * s.p0.x + b * s.c1.x + c * s.c2.x + e * s.p1.x,
          y: a * s.p0.y + b * s.c1.y + c * s.c2.y + e * s.p1.y,
        });
      }
    }

    const cum = [0];
    for (let i = 1; i < pts.length; i++) {
      cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
    }
    const length = cum[cum.length - 1];

    const out: PathSample[] = [];
    let j = 0;
    for (let i = 0; i <= PATH_SAMPLE_COUNT; i++) {
      const v = i / PATH_SAMPLE_COUNT;
      const target = v * length;
      while (j < cum.length - 2 && cum[j + 1] < target) j++;
      const f = (target - cum[j]) / (cum[j + 1] - cum[j] || 1);
      const x = pts[j].x + (pts[j + 1].x - pts[j].x) * f;
      const y = pts[j].y + (pts[j + 1].y - pts[j].y) * f;

      let nearest = -1;
      let bestSq = NEAR_DIST_SQ;
      for (let k = 0; k < nodes.length; k++) {
        const dx = x - nodes[k].x;
        const dy = y - nodes[k].y;
        const dSq = dx * dx + dy * dy;
        if (dSq < bestSq) {
          bestSq = dSq;
          nearest = k;
        }
      }

      out.push({ x, y, opacity: fade(v), nearest });
    }
    return out;
  }

  /* Tables outlive section re-entry and re-inits, so the work runs once per path */
  const sampleCache = new Map<string, PathSample[]>();

  function getSamples(d: string, nodes: Pt[]): PathSample[] {
    const key = `${d}|${nodes.map((p) => `${p.x},${p.y}`).join(';')}`;
    let samples = sampleCache.get(key);
    if (!samples) {
      samples = samplePath(d, nodes);
      sampleCache.set(key, samples);
    }
    return samples;
  }

  function initHookFlow() {
    const hookFlowWindow = window as HookFlowWindow;
    hookFlowWindow.__bubHookFlowCleanup?.();
    hookFlowWindow.__bubHookFlowCleanup = undefined;

    const root = document.querySelector('[data-hook-flow]') as HTMLElement | null;
    if (!root) return;

    let stopAnim: (() => void) | null = null;
    let rootInView = false;
    let activeIdx = -1;
    let currentMobile: boolean | null = null;

    const nodeEls = Array.from(root.querySelectorAll('[data-hook-node]')) as HTMLElement[];
    const dot = root.querySelector('[data-hook-dot]') as SVGCircleElement | null;
    const dotTrail = root.querySelector('[data-hook-dot-trail]') as SVGCircleElement | null;
    if (!dot || !nodeEls.length) return;

    const mql = window.matchMedia('(max-width: 639px)');
    const reduceMotionMql = window.matchMedia('(prefers-reduced-motion: reduce)');

    function stopAnimation() {
      stopAnim?.();
      stopAnim = null;
      currentMobile = null;
    }

    function maybeStartAnimation() {
      if (!rootInView || document.visibilityState === 'hidden' || reduceMotionMql.matches) return;
      setupAnimation(mql.matches);
    }

    function setupAnimation(isMobile: boolean) {
      if (isMobile === currentMobile) return;
      currentMobile = isMobile;

      stopAnim?.();
      stopAnim = null;
      activeIdx = -1;

      const group = isMobile ? '.hook-paths-mobile' : '.hook-paths-desktop';
      const svgPath = root!.querySelector(`${group} path:first-child`) as SVGPathElement | null;
      const trail = root!.querySelector(
        isMobile ? '[data-hook-trail-mobile]' : '[data-hook-trail]',
      ) as SVGPathElement | null;

      if (!svgPath || !trail) return;

      const nodeCoords = nodeEls.map((el) => {
        const idx = Number(el.dataset.hookNode);
        return {
          x: isMobile ? CX_MOBILE : idx % 2 === 0 ? RX : LX,
          y: FIRST_Y + idx * SPACING,
        };
      });

      const samples = getSamples(svgPath.getAttribute('d') ?? '', nodeCoords);

      const cycleMs = CYCLE_DUR * 1000;
      const loopMs = cycleMs + REPEAT_DELAY_MS;
      const startedAt = performance.now();
      let rafId = 0;

      function setDotVisible(visible: boolean) {
        const value = visible ? 'visible' : 'hidden';
        dot!.style.visibility = value;
        if (dotTrail) dotTrail.style.visibility = value;
      }

      function hideDot() {
        dot!.style.opacity = '0';
        if (dotTrail) dotTrail.style.opacity = '0';
      }

      function highlightNode(idx: number) {
        if (idx === activeIdx) return;
        activeIdx = idx;
        nodeEls.forEach((el, i) => el.classList.toggle('active', i === idx));
      }

      function paint(now: number) {
        const elapsed = (now - startedAt) % loopMs;

        if (elapsed > cycleMs) {
          hideDot();
          highlightNode(-1);
          return;
        }

        const v = elapsed / cycleMs;
        const sampleIndex = Math.min(PATH_SAMPLE_COUNT, Math.max(0, Math.round(v * PATH_SAMPLE_COUNT)));
        const sample = samples[sampleIndex];

        dot!.style.transform = `translate(${sample.x}px, ${sample.y}px)`;
        dot!.style.opacity = String(sample.opacity);

        if (dotTrail) {
          const trailIndex = Math.max(0, sampleIndex - Math.round(TRAIL_LEAD * PATH_SAMPLE_COUNT));
          const trailSample = samples[trailIndex];
          dotTrail.style.transform = `translate(${trailSample.x}px, ${trailSample.y}px)`;
          dotTrail.style.opacity = String(sample.opacity * 0.35);
        }

        trail!.style.strokeDashoffset = String(TRAIL_DASH - v);
        trail!.style.opacity = String(sample.opacity * 0.35);
        highlightNode(sample.nearest);
      }

      // rAF, not setInterval: vsync-aligned, and paused while the tab is hidden
      function frame(now: number) {
        rafId = requestAnimationFrame(frame);
        paint(now);
      }

      setDotVisible(true);
      trail.style.strokeDashoffset = String(TRAIL_DASH);
      rafId = requestAnimationFrame(frame);

      stopAnim = () => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
        hideDot();
        setDotVisible(false);
        trail!.style.opacity = '0';
        trail!.style.strokeDashoffset = String(TRAIL_DASH);
        activeIdx = -1;
        nodeEls.forEach((el) => el.classList.remove('active'));
      };
    }

    const handleMediaChange = () => {
      const wasRunning = stopAnim !== null;
      stopAnimation();
      if (wasRunning) maybeStartAnimation();
    };

    const handleMotionPreferenceChange = () => {
      if (reduceMotionMql.matches) {
        stopAnimation();
      } else {
        maybeStartAnimation();
      }
    };

    const handleVisibilityChange = () => {
      if (document.visibilityState === 'hidden') {
        stopAnimation();
      } else {
        maybeStartAnimation();
      }
    };

    mql.addEventListener('change', handleMediaChange);
    reduceMotionMql.addEventListener('change', handleMotionPreferenceChange);
    document.addEventListener('visibilitychange', handleVisibilityChange);

    const stopInView = inView(
      root,
      () => {
        rootInView = true;
        maybeStartAnimation();
        return () => {
          rootInView = false;
          stopAnimation();
        };
      },
      { margin: '-8% 0px' },
    );

    hookFlowWindow.__bubHookFlowCleanup = () => {
      stopInView();
      mql.removeEventListener('change', handleMediaChange);
      reduceMotionMql.removeEventListener('change', handleMotionPreferenceChange);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      rootInView = false;
      stopAnimation();
    };
  }

  const hookFlowWindow = window as HookFlowWindow;

  initHookFlow();
  if (!hookFlowWindow.__bubHookFlowPageLoadBound) {
    document.addEventListener('astro:page-load', initHookFlow);
    hookFlowWindow.__bubHookFlowPageLoadBound = true;
  }
</script>
