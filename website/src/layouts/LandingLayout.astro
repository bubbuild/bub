---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL } from 'astro:env/client';

interface Props {
  title: string;
  description: string;
  ogImage: string;
}

const { title, description, ogImage } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalUrl={SITE_URL}
  bodyClass="ambient-page min-h-screen antialiased font-sans"
>
  <main id="main-content" class="relative isolate">
    <div class="divide-y divide-border">
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  :global(body.ambient-page) {
    --ambient-gradient:
      radial-gradient(ellipse 60% 50% at 12% 8%, var(--site-ambient-1), transparent),
      radial-gradient(ellipse 50% 45% at 88% 42%, var(--site-ambient-2), transparent),
      radial-gradient(ellipse 55% 50% at 32% 85%, var(--site-ambient-3), transparent);
    /* the base layer paints bg-background on body; drop it so the glow layer below shows */
    background-color: transparent;
  }

  /* The glow sits on its own viewport-anchored layer, which the compositor just reuses —
     a fixed-attachment background would be re-rasterized on every scroll frame instead.
     It stays opaque and behind body on purpose: html paints its own background, so body
     would otherwise paint over this layer rather than let it through. */
  :global(body.ambient-page)::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-color: var(--background);
    background-image: var(--ambient-gradient);
  }

  /* Sticky at the viewport origin, so a viewport-sized image lands on the same pixels
     background-attachment: fixed would produce, without the per-frame re-raster */
  :global(body.ambient-page > header) {
    background-color: color-mix(in oklch, var(--background) 82%, transparent);
    background-image: var(--ambient-gradient);
    background-size: 100vw 100vh;
    background-repeat: no-repeat;
    backdrop-filter: blur(12px) saturate(1.2);
  }

  :global(body.ambient-page > header .mobile-dropdown) {
    background-color: color-mix(in oklch, var(--background) 96%, transparent);
    background-image: var(--ambient-gradient);
    background-attachment: fixed;
    backdrop-filter: blur(20px) saturate(1.2);
  }

  :global(body.ambient-page > footer) {
    background-color: color-mix(in oklch, var(--background) 55%, transparent);
    background-image: var(--ambient-gradient);
    background-attachment: fixed;
    backdrop-filter: blur(8px);
  }
</style>
