# Copy to .env and fill in your own values. Existing environment variables win over .env.
# cp .env.example .env

BUB_MODEL=openai:gpt-4o-mini
BUB_API_BASE=https://api.openai.com/v1

# Required. REPUBLIC_OPENAI_API_KEY works as a fallback.
BUB_API_KEY=sk-...

# Server bind address
BUB_HOST=127.0.0.1
BUB_PORT=8000
