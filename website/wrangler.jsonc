{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bub",
  // The newest date the pinned `wrangler` binary can actually run. Going past it
  // breaks `pnpm dev` / `pnpm preview`; see DEPLOYMENT.md before moving this.
  "compatibility_date": "2026-10-13",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
