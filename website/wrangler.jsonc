{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bub",
  // Must not be newer than the `workerd` bundled with the pinned `wrangler`, or
  // `pnpm dev` / `pnpm preview` refuse to start.
  "compatibility_date": "2026-10-13",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
